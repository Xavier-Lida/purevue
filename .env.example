# Clé API Resend pour l'envoi des demandes de soumission par courriel.
# 1. Crée un compte gratuit sur https://resend.com
# 2. Vérifie ton domaine (ou utilise l'adresse de test onboarding@resend.dev au début)
# 3. Copie ta clé API ici, puis renomme ce fichier en .env.local
RESEND_API_KEY=

# Adresse qui reçoit les demandes de soumission (par défaut: purevue64@gmail.com)
CONTACT_TO_EMAIL=purevue64@gmail.com

# Adresse d'expédition affichée (doit appartenir à un domaine vérifié dans Resend).
# Au début, tu peux laisser onboarding@resend.dev pour tester.
CONTACT_FROM_EMAIL=onboarding@resend.dev
